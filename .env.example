##
## Copy to server/.env  (or export these in your shell) and fill in the key.
##   cp .env.example server/.env
##

# ---------------------------------------------------------------- optional ---

# The Gemini key is normally entered in the app's Settings dialog and kept in the
# browser, so this is only needed for headless use — curl, the smoke test, CI, or
# a shared deployment where users should not supply their own key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------ models ---

# Defaults shown in the app's model pickers; a user can override either one from
# Settings for their own session.
#
# Page analysis. Runs once per page and is the hard visual task (reading a ruled,
# possibly scanned page and locating every blank), so it gets the stronger model.
# gemini-2.5-flash also works and is ~3x cheaper if your forms are clean digital
# PDFs rather than scans.
GEMINI_ANALYSIS_MODEL=gemini-2.5-pro

# Conversation extraction. Runs on every meaningful chat turn and sits in the
# user's critical path, so it gets the fast model.
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash

# Thinking budgets, in tokens.
#   0  = thinking off. Correct for extraction: the task is shallow (map a
#        sentence onto a supplied list of ids) and thinking would add hundreds of
#        milliseconds to a latency-critical call for no accuracy gain.
#  -1  = let the model decide. Correct for analysis, which is one-off and hard.
GEMINI_EXTRACTION_THINKING_BUDGET=0
GEMINI_ANALYSIS_THINKING_BUDGET=-1

# ------------------------------------------------------------------- scope ---

# Leading pages analyzed per upload. Each page is one model call, so this is the
# main cost/coverage dial. Pages are analyzed concurrently, so raising it costs
# tokens rather than wall-clock time. Documents with fewer pages are unaffected.
MAX_ANALYZED_PAGES=2

# ----------------------------------------------------------------- tuning ---

PORT=4000
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=26214400
DATA_DIR=

# Cap on fields sent to the extraction model per turn (empty fields go first).
MAX_CATALOG_FIELDS=120
# Conversation turns included as context per extraction call.
MAX_CONVERSATION_TURNS=6

# ------------------------------------------------------------------- local ---

# Serve a captured fixture instead of calling Gemini. For UI work and offline
# demos only — it renders the sample form regardless of what you upload.
MOCK_GEMINI=false
